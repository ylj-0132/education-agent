{
  "version": "java-basics-pilot-v3",
  "status": "provisional",
  "scope": "依据Java_5训练题扩充的31项候选知识点目录，不是完整Java课程或已核验图谱。未观测不表示不会；不从模板代码推断掌握。",
  "concepts": {
    "java.input": "输入读取：按题目格式读取所有值，区分读取次数与循环条件。",
    "java.integer_arithmetic": "整数运算：加减乘除、取余与整除边界。",
    "java.condition": "条件判断：比较运算、逻辑组合及边界等号。",
    "java.loop": "循环控制：初始化、循环条件、更新、终止与重复处理。",
    "java.array": "数组使用：存储、下标、遍历及元素更新；main参数不作证据。",
    "java.string": "字符串与字符：读取、字符访问、计数和比较；类型声明不作证据。",
    "java.sort": "排序与顺序：按题意选择顺序并使用排序结果。",
    "java.syntax": "Java语法与字面量：关键字、类型和数字字面量；平台类名要求单独说明。",
    "algorithm.enumeration": "枚举与效率：候选遍历、重复计算及规模约束；未经运行不能称实际超时。",
    "java.output": "输出格式：按题意输出值、固定文本与多行结果；区分平台入口规范和语言知识。",
    "java.numeric_range": "数值范围与类型选择：根据中间结果和输入范围选择数值表示，识别溢出风险；仅声明long不作掌握证据。",
    "java.floating_point": "浮点数与精度：实数计算、整数与浮点除法、精度及输出要求；不用浮点也可能是合理解法。",
    "java.assignment": "赋值与状态更新：变量交换、更新顺序和旧值保留；不因出现赋值语句就判断掌握。",
    "java.string_comparison": "字符串比较：内容相等、字典序和逐字符比较；只评价提交实际采用的比较方式。",
    "java.string_transformation": "字符串构造与变换：截取、替换、拼接及局部字符修改；注意索引和长度边界。",
    "java.collections_set": "集合与去重：成员判断、去重和不同元素计数；数组标记等替代方案不因未用Set而判错。",
    "java.collections_map": "映射与键值统计：维护键到数量或状态的对应关系；频次数组等替代实现同样有效。",
    "algorithm.counting": "计数与频次统计：计数条件、计数器初始化与重复统计；区分具体统计逻辑与使用容器。",
    "algorithm.aggregation": "累加与汇总：按条件累加、总量计算及初值选择；判断循环范围和累计对象是否正确。",
    "algorithm.extrema": "最大最小值：极值初始化、更新和候选范围；不要把调用min或max直接当作充分证据。",
    "algorithm.digit_processing": "数位与进制表示：十进制数位提取、字符转数字和进制位数；与Java源码字面量规则分开。",
    "algorithm.rounding": "整除与取整建模：向上或向下取整、余量处理与整除边界；不能将实数公式直接套入整数运算。",
    "algorithm.simulation": "过程模拟：依题意维护状态、轮次与停止条件；区分单步更新和整轮更新。",
    "algorithm.greedy": "贪心选择：说明局部选择为何满足全局目标；排序或选择较小值本身不构成正确性证明。",
    "algorithm.prefix_aggregation": "前缀汇总：维护前缀极值、累计量等信息并避免重复扫描；不强制要求前缀和数组。",
    "algorithm.number_theory": "基础数论：整除、因数、素数、最大公约数与最小公倍数；只评价本题实际展示的部分。",
    "algorithm.combinatorics": "基础组合计数：按类别计数、配对及避免重计；区分计数公式与枚举实现。",
    "algorithm.interval": "区间与距离：端点包含、区间交集、绝对差及距离条件；按题目实际约束处理边界。",
    "algorithm.dynamic_programming": "动态规划基础：状态含义、初始条件、转移和计算顺序；不能仅凭使用数组推断掌握。",
    "algorithm.graph_basics": "图与关系建模：点边关联、度数或确定后继的遍历与重复访问检测；不扩展为最短路等未展示能力。",
    "algorithm.complexity": "规模与复杂度：结合输入范围分析循环次数和存储量；不能从代码可运行反推学生主动做过复杂度分析。"
  },
