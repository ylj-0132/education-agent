# Copy to .env locally. Never send the API key in chat.
ZZZ_API_KEY=
# Use your console's Chat Completions compatible base URL, ending in /v1.
ZZZ_BASE_URL=https://api.zhizengzeng.com/v1
# Legacy fallback for old experiment scripts and env files.
ZZZ_MODEL=gpt-5.6-luna
ZZZ_MAX_CALLS=12
ZZZ_MAX_TOKENS=1500
ZZZ_TIMEOUT=60
# Routing: extract/review -> strong; summarize/recommend/generate/revise -> weak.
# Temporary all-Luna configuration (2026-11-04); restore strong to Terra when requested.
ZZZ_STRONG_MODEL=gpt-5.6-luna
ZZZ_WEAK_MODEL=gpt-5.6-luna
